{
  "name": "gmc-web-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/next-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm lint && pnpm typecheck",
    "postinstall": "prisma generate && node scripts/fix-prisma-client-wrappers.mjs && node scripts/prepare-chromium-assets.mjs",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:delete-generated": "node --env-file=.env --import tsx prisma/delete-generated-requests.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@sparticuz/chromium": "^149.0.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "next": "^15.0.0",
    "puppeteer-core": "^25.8.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.0.0",
    "turbo": "^2.10.1",
    "typescript": "^5.0.0"
  }
}
